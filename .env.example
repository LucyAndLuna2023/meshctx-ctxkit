# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# ── Free tools: nothing needed ──────────────────────────────────────────
# memory and ctx_verify_text work with zero configuration.

# ── Where memories live ─────────────────────────────────────────────────
# CTXKIT_HOME=~/.ctxkit

# ── Paid tier: ctx_consensus ────────────────────────────────────────────
# Requires: pip install 'meshctx-ctxkit[api]'
# Your licence (email from the purchase, or ~/.ctxkit/license.key)
# CTXKIT_LICENSE=
# An OpenAI-compatible endpoint and your own key. Calls are billed to YOU.
# CTXKIT_API_BASE=https://api.openai.com/v1
# CTXKIT_API_KEY=
# CTXKIT_MODELS=gpt-4o-mini,claude-3-5-haiku,gemini-2.0-flash

# ── Billing service (server-side only, not needed to use the client) ────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
